# --- Contact form (Resend) ---
# API key from https://resend.com/api-keys. Server-side only, never exposed to the client.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Sender address used by Resend. Until a domain is verified in Resend,
# you must use their shared test sender "onboarding@resend.dev" (works for
# sending to any recipient without domain verification). Once a domain is
# verified for this project, change this to an address on that domain
# (e.g. "contacto@tudominio.com") for better deliverability.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- SEO ---
# Absolute site URL, used for metadataBase, sitemap and Open Graph/Twitter
# image resolution. Leave unset until a production domain exists — do not
# fill this in with a placeholder/invented domain. Example once available:
# NEXT_PUBLIC_SITE_URL=https://gretpediatra.com
NEXT_PUBLIC_SITE_URL=
