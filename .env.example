# --- Contact form (Resend) ---
# API key from https://resend.com/api-keys. Server-side only, never exposed to the client.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=gretpediatra@gmail.com

# Sender address used by Resend. The gretpediatra.com domain is not yet
# verified in Resend, so this must stay on their shared test sender
# "onboarding@resend.dev" (works for sending to any recipient without
# domain verification). Once gretpediatra.com is verified in Resend,
# change this to an address on that domain (e.g. "contacto@gretpediatra.com")
# for better deliverability.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- SEO ---
# Absolute site URL, used for metadataBase, sitemap and Open Graph/Twitter
# image resolution. The code falls back to this domain even if unset here,
# but set it explicitly once the site is actually deployed at this domain.
NEXT_PUBLIC_SITE_URL=https://gretpediatra.com
